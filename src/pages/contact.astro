---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StickyHeader from '@/components/custom/StickyHeader.astro';
import ContactForm from '@/components/custom/ContactForm.astro';
import { siteConfig } from '@/site.config';
---

<BaseLayout title="Contact Us">
  <StickyHeader />
  <main id="main-content" class="pt-20">
    <!-- Hero -->
    <section class="py-16">
      <div class="section-container text-center reveal">
        <h1 class="text-4xl md:text-5xl font-black tracking-tight text-foreground mb-4">
          Get In Touch
        </h1>
        <p class="text-lg text-muted-foreground max-w-xl mx-auto">
          We're here to help with all your home service needs — reach out today
        </p>
      </div>
    </section>

    <!-- Contact Info -->
    <section class="py-10" aria-label="Contact information">
      <div class="section-container">
        <div class="max-w-4xl mx-auto grid md:grid-cols-3 gap-6 mb-16 reveal-stagger">
          <div class="card-hover text-center reveal">
            <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center mx-auto mb-4" aria-hidden="true">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
            </div>
            <h2 class="font-bold text-foreground mb-1">Call Us</h2>
            <a href={`tel:${siteConfig.phone}`} class="text-sm text-primary font-semibold hover:underline">
              {siteConfig.phone}
            </a>
            <p class="text-xs text-muted-foreground mt-1">{siteConfig.hours}</p>
          </div>

          <div class="card-hover text-center reveal">
            <div class="w-12 h-12 bg-emerald-50 rounded-lg flex items-center justify-center mx-auto mb-4" aria-hidden="true">
              <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <h2 class="font-bold text-foreground mb-1">Email Us</h2>
            <a href={`mailto:${siteConfig.email}`} class="text-sm text-primary font-semibold hover:underline">
              {siteConfig.email}
            </a>
            <p class="text-xs text-muted-foreground mt-1">We respond within 24 hours</p>
          </div>

          <div class="card-hover text-center reveal">
            <div class="w-12 h-12 bg-amber-50 rounded-lg flex items-center justify-center mx-auto mb-4" aria-hidden="true">
              <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <h2 class="font-bold text-foreground mb-1">Our Location</h2>
            <p class="text-sm text-muted-foreground">
              {siteConfig.address.city}, {siteConfig.address.state}
            </p>
            <p class="text-xs text-muted-foreground mt-1">
              Serving {siteConfig.serviceAreas.length}+ cities
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Form -->
    <section id="contact-form" class="py-16 bg-(--background-light)" aria-labelledby="form-heading">
      <div class="section-container">
        <div class="text-center mb-12 reveal">
          <h2 id="form-heading" class="section-heading">Request a Free Quote</h2>
          <p class="section-subheading">
            Fill out the form below and we'll send your personalized estimate
          </p>
        </div>
        <div class="reveal">
          <ContactForm />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
