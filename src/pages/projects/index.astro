---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StickyHeader from '@/components/custom/StickyHeader.astro';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) =>
  b.data.completionDate.getTime() - a.data.completionDate.getTime()
);
---

<BaseLayout title="Our Projects">
  <StickyHeader />
  <main id="main-content" class="pt-20">
    <!-- Page Header -->
    <section class="py-16">
      <div class="section-container text-center reveal">
        <h1 class="text-4xl md:text-5xl font-black tracking-tight text-foreground mb-4">
          Before & After Gallery
        </h1>
        <p class="text-lg text-muted-foreground max-w-xl mx-auto">
          Browse real customer projects and see the quality of our craftsmanship
        </p>
      </div>
    </section>

    <!-- Projects Grid -->
    <section class="pb-24" aria-label="Project gallery">
      <div class="section-container">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 reveal-stagger">
          {sortedProjects.map(project => (
            <a
              href={`/projects/${project.slug}`}
              class="group block reveal"
              aria-label={`View ${project.data.title} — ${project.data.serviceType} project${project.data.location ? ` in ${project.data.location}` : ''}`}
            >
              <div class="relative rounded-xl overflow-hidden mb-4">
                <Image
                  src={project.data.afterImage}
                  alt={`Completed ${project.data.title}`}
                  class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                  width={400}
                  height={300}
                  loading="lazy"
                />
                {project.data.featured && (
                  <span class="absolute top-3 right-3 bg-secondary text-secondary-foreground text-xs font-semibold px-2.5 py-1 rounded-full">
                    Featured
                  </span>
                )}
              </div>
              <h2 class="text-base font-bold text-foreground group-hover:text-primary transition-colors">
                {project.data.title}
              </h2>
              <p class="text-sm text-muted-foreground mt-1">
                {project.data.serviceType}
                {project.data.location && ` \u2022 ${project.data.location}`}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
