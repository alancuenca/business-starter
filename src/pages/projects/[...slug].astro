---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StickyHeader from '@/components/custom/StickyHeader.astro';
import Breadcrumbs from '@/components/custom/Breadcrumbs.astro';
import ProjectSidebar from '@/components/custom/ProjectSidebar.astro';
import BeforeAfterSlider from '@/components/custom/BeforeAfterSlider.astro';
import { siteConfig } from '@/site.config';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric'
}).format(project.data.completionDate);

const allProjects = await getCollection('projects');
const relatedProjects = allProjects
  .filter(p => p.slug !== project.slug)
  .slice(0, 3);
---

<BaseLayout
  title={project.data.title}
  description={project.data.metaDescription}
>
  <StickyHeader />
  <main id="main-content" class="pt-20">
    <article class="section-container py-10">
      <!-- Breadcrumbs -->
      <Breadcrumbs items={[
        { label: 'Projects', href: '/projects' },
        { label: project.data.title },
      ]} />

      <!-- Header -->
      <div class="mb-10 reveal">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="inline-flex items-center gap-1.5 bg-green-50 text-green-700 text-xs font-semibold px-3 py-1 rounded-full">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            Completed
          </span>
          {project.data.duration && (
            <span class="inline-flex items-center text-xs font-medium text-muted-foreground bg-muted px-3 py-1 rounded-full">
              {project.data.duration}
            </span>
          )}
          <span class="inline-flex items-center text-xs font-medium text-muted-foreground bg-muted px-3 py-1 rounded-full">
            {formattedDate}
          </span>
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-foreground mb-3">
          {project.data.title}
        </h1>
        <p class="text-lg text-muted-foreground max-w-2xl">
          {project.data.metaDescription}
        </p>
      </div>

      <!-- Two-column layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        <!-- Main Content (8/12) -->
        <div class="lg:col-span-8 space-y-10">
          <!-- Interactive Before/After Slider -->
          <div class="reveal">
            <BeforeAfterSlider
              beforeImage={project.data.beforeImage}
              afterImage={project.data.afterImage}
              alt={project.data.title}
              beforeLabel="Before"
              afterLabel="After"
            />
          </div>

          <!-- Project Overview -->
          <div class="prose prose-slate max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-p:text-muted-foreground prose-p:leading-relaxed reveal">
            <Content />
          </div>

          <!-- Work Completed -->
          <div class="reveal">
            <h2 class="text-xl font-bold text-foreground mb-4">Work Completed</h2>
            <ul class="space-y-3" role="list">
              {project.data.workDone.map(item => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-sm text-muted-foreground">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Work Breakdown Accordions -->
          {project.data.workBreakdown && project.data.workBreakdown.length > 0 && (
            <div class="reveal">
              <h2 class="text-xl font-bold text-foreground mb-4">Project Breakdown</h2>
              <div class="space-y-2">
                {project.data.workBreakdown.map(item => (
                  <details class="group border border-border rounded-lg">
                    <summary class="flex items-center justify-between p-4 cursor-pointer text-sm font-semibold text-foreground hover:text-primary transition-colors">
                      {item.title}
                      <svg class="w-4 h-4 text-muted-foreground group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                      </svg>
                    </summary>
                    <div class="px-4 pb-4 text-sm text-muted-foreground leading-relaxed">
                      {item.description}
                    </div>
                  </details>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar (4/12) -->
        <div class="lg:col-span-4">
          <ProjectSidebar />
        </div>
      </div>

      <!-- Related Projects -->
      {relatedProjects.length > 0 && (
        <div class="mt-24 pt-10 border-t border-border reveal">
          <h2 class="section-heading mb-8">Related Projects</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {relatedProjects.map(relProject => (
              <a
                href={`/projects/${relProject.slug}`}
                class="group block"
                aria-label={`View related project: ${relProject.data.title}`}
              >
                <div class="relative rounded-xl overflow-hidden mb-4">
                  <Image
                    src={relProject.data.afterImage}
                    alt={`Completed ${relProject.data.title}`}
                    class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                    width={400}
                    height={300}
                    loading="lazy"
                  />
                </div>
                <h3 class="text-base font-bold text-foreground group-hover:text-primary transition-colors">
                  {relProject.data.title}
                </h3>
                <p class="text-sm text-muted-foreground mt-1">{relProject.data.serviceType}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </article>
  </main>
</BaseLayout>
