---
import { Image } from 'astro:assets';
import { siteConfig } from '@/site.config';
import heroImage from '@/assets/images/hero.jpg';
---

<!-- CUSTOMIZE: Hero section with photo background, reveal animation, and stats bar -->
<section class="pt-20" aria-labelledby="hero-heading">
  <div class="section-container py-6">
    <!-- Hero Card -->
    <div class="relative overflow-hidden rounded-2xl min-h-[540px] md:min-h-[580px] flex items-end">
      <!-- Background Image -->
      <Image
        src={heroImage}
        alt=""
        role="presentation"
        class="absolute inset-0 w-full h-full object-cover"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        loading="eager"
        quality={80}
      />
      <!-- Dark Overlay -->
      <div class="absolute inset-0 bg-linear-to-r from-black/80 via-black/55 to-black/20"></div>

      <!-- Content -->
      <div class="relative z-10 p-8 md:p-12 lg:p-16 max-w-2xl">
        <!-- Badge Pill -->
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm text-white text-xs font-semibold tracking-wide uppercase px-4 py-2 rounded-full mb-6 border border-white/15 reveal">
          <svg class="w-4 h-4 text-secondary fill-current" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
          </svg>
          #1 Rated Home Services
        </div>

        <!-- Headline -->
        <h1 id="hero-heading" class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-white mb-4 leading-[1.08] reveal">
          Your Trusted<br />
          <span class="text-primary">Home Repair</span> Experts
        </h1>

        <!-- Subheadline -->
        <p class="text-base md:text-lg text-white/70 mb-8 max-w-lg leading-relaxed reveal">
          Professional plumbing, electrical, and renovation services.
          Serving {siteConfig.serviceAreas.slice(0, 2).join(', ')} and surrounding areas.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 reveal">
          <a href="/contact" data-testid="cta-contact" class="cta-primary text-base px-8 py-3.5">
            Get your free quote
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href={`tel:${siteConfig.phone}`} class="cta-ghost text-base px-8 py-3.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            Call us at {siteConfig.phone}
          </a>
        </div>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 py-10 border-b border-border reveal-stagger" role="list" aria-label="Company statistics">
      {siteConfig.stats.map(stat => (
        <div class="text-center reveal" role="listitem">
          <div class="text-3xl md:text-4xl font-black text-primary tracking-tight">
            {stat.value}
          </div>
          <div class="text-sm text-muted-foreground mt-1 font-medium">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
