---
import { getCollection } from 'astro:content';
import { siteConfig } from '@/site.config';

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<!-- CUSTOMIZE: Footer with 4 columns, contact info, social links -->
<footer class="border-t border-border mt-auto" role="contentinfo">
  <div class="section-container py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Column 1: Brand -->
      <div>
        <a href="/" class="flex items-center gap-2.5 mb-4" aria-label={`${siteConfig.businessName} — home page`}>
          <div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center" aria-hidden="true">
            <svg class="w-4.5 h-4.5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" />
            </svg>
          </div>
          <span class="text-lg font-bold text-foreground">{siteConfig.businessName}</span>
        </a>
        <p class="text-sm text-muted-foreground leading-relaxed">
          {siteConfig.description}
        </p>
      </div>

      <!-- Column 2: Services -->
      <nav aria-label="Services">
        <h4 class="text-sm font-bold text-foreground uppercase tracking-wider mb-4">Services</h4>
        <ul class="space-y-3">
          {sortedServices.map(service => (
            <li>
              <a href={`/services/${service.slug}`} class="text-sm text-muted-foreground hover:text-primary transition-colors">
                {service.data.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Column 3: Company -->
      <nav aria-label="Company links">
        <h4 class="text-sm font-bold text-foreground uppercase tracking-wider mb-4">Company</h4>
        <ul class="space-y-3">
          {siteConfig.footerLinks.company.map(link => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Column 4: Contact -->
      <div>
        <h4 class="text-sm font-bold text-foreground uppercase tracking-wider mb-4">Contact</h4>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 text-muted-foreground mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span class="text-sm text-muted-foreground">
              {siteConfig.address.street}<br />
              {siteConfig.address.city}, {siteConfig.address.state} {siteConfig.address.zip}
            </span>
          </li>
          <li>
            <a href={`tel:${siteConfig.phone}`} class="flex items-center gap-3 text-sm text-muted-foreground hover:text-primary transition-colors" aria-label={`Call us at ${siteConfig.phone}`}>
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              {siteConfig.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${siteConfig.email}`} class="flex items-center gap-3 text-sm text-muted-foreground hover:text-primary transition-colors" aria-label={`Email us at ${siteConfig.email}`}>
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              {siteConfig.email}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-border">
    <div class="section-container py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-muted-foreground">
        &copy; {new Date().getFullYear()} {siteConfig.businessName}. All rights reserved. License #{siteConfig.licenseNumber}
      </p>
      <nav aria-label="Social media links">
        <ul class="flex items-center gap-4">
          {siteConfig.socialLinks.facebook && (
            <li>
              <a href={siteConfig.socialLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${siteConfig.businessName} on Facebook`} class="text-muted-foreground hover:text-primary transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            </li>
          )}
          {siteConfig.socialLinks.instagram && (
            <li>
              <a href={siteConfig.socialLinks.instagram} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${siteConfig.businessName} on Instagram`} class="text-muted-foreground hover:text-primary transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              </a>
            </li>
          )}
          {siteConfig.socialLinks.twitter && (
            <li>
              <a href={siteConfig.socialLinks.twitter} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${siteConfig.businessName} on X (Twitter)`} class="text-muted-foreground hover:text-primary transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            </li>
          )}
          {siteConfig.socialLinks.yelp && (
            <li>
              <a href={siteConfig.socialLinks.yelp} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${siteConfig.businessName} on Yelp`} class="text-muted-foreground hover:text-primary transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.16 12.594l-4.995 1.433c-.96.276-1.74-.8-1.176-1.63l2.96-4.344c.564-.828 1.836-.384 1.836.636v3.268c0 .276-.24.54-.624.636zM13.365 15.62l-2.3 4.71c-.384.792-1.596.528-1.596-.348v-5.04c0-.936.972-1.548 1.836-1.152l1.752.876c.792.396.84 1.416.312 1.956l-.004-.002zm-5.22-4.476l-5.244-2.244c-.84-.36-.72-1.572.168-1.764l5.04-1.08c.96-.204 1.716.78 1.356 1.68l-1.032 2.604c-.288.72-1.104 1.08-1.764.804h.476zm-.828 2.16l-5.088 1.356c-.876.228-1.356-.78-.684-1.44l3.876-3.792c.696-.684 1.8-.24 1.92.672l.204 2.616c.048.432-.288.708-.696.636l.468-.048zm6.024-6.84l-1.356-5.088c-.228-.876.78-1.356 1.44-.684l3.792 3.876c.684.696.24 1.8-.672 1.92l-2.616.204c-.432.048-.708-.288-.636-.696l.048.468z"/></svg>
              </a>
            </li>
          )}
        </ul>
      </nav>
    </div>
  </div>
</footer>
